<UserControl x:Class="TheMovies.UI.Views.RegistrerFilmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TheMovies.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                   Text="Registrer Film" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Grid.Column="0" 
                   Text="Titel:" 
                   VerticalAlignment="Center" 
                   Margin="0,5"/>
        <TextBox Grid.Row="1" Grid.Column="1" 
                 Text="{Binding Titel, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="5" 
                 Padding="5"/>

        <TextBlock Grid.Row="2" Grid.Column="0" 
                   Text="Genre:" 
                   VerticalAlignment="Center" 
                   Margin="0,5"/>
        <TextBox Grid.Row="2" Grid.Column="1" 
                 Text="{Binding Genre, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="5" 
                 Padding="5"/>

		<TextBlock Grid.Row="3" Grid.Column="0"
					   Text="Varighed:"
					   VerticalAlignment="Center"
					   Margin="0,5"/>
		<StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="5">
			<TextBox Text="{Binding VarighedTimer, UpdateSourceTrigger=PropertyChanged}" 
					 Width="50" Padding="5" Margin="0,0,5,0"/>
			<TextBlock Text="timer" VerticalAlignment="Center" Margin="0,0,10,0"/>

			<TextBox Text="{Binding VarighedMinutter, UpdateSourceTrigger=PropertyChanged}" 
					 Width="50" Padding="5" Margin="0,0,5,0"/>
			<TextBlock Text="minutter" VerticalAlignment="Center"/>
		</StackPanel>

		<TextBlock Grid.Row="4" Grid.Column="0"
                   Text="Instruktør:"
                   VerticalAlignment="Center"
                   Margin="0,5"/>
		<TextBox Grid.Row="4" Grid.Column="1"
                 Text="{Binding Instruktør, UpdateSourceTrigger=PropertyChanged}"
                 Margin="5"
                 Padding="5"/>
		
		<TextBlock Grid.Row="5" Grid.Column="0"
					   Text="Premiere dato:"
					   VerticalAlignment="Center"
					   Margin="0,5"/>
		<DatePicker Grid.Row="5" Grid.Column="1"
					 SelectedDate="{Binding PremiereDato, UpdateSourceTrigger=PropertyChanged}"
					 Margin="5"
					 Padding="5"/>

        <Button Grid.Row="6" Grid.Column="1" 
                Content="Tilføj Film" 
                Command="{Binding GemFilmCommand}"
                HorizontalAlignment="Left"
                Padding="20,10"
                Margin="5,20,5,5"
                Background="#007ACC"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"/>
    </Grid>
</UserControl>
