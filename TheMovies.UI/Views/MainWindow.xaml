<Window x:Class="TheMovies.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TheMovies.UI"
        xmlns:views="clr-namespace:TheMovies.UI.Views"
        xmlns:viewModels="clr-namespace:TheMovies.UI.ViewModels"
        xmlns:helpers="clr-namespace:TheMovies.UI.Helpers"
        mc:Ignorable="d"
        Title="The Movies" Height="450" Width="800">

    <Window.Resources>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <DataTemplate DataType="{x:Type viewModels:FilmoversigtViewModel}">
            <views:FilmoversigtView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:RegistrerFilmViewModel}">
            <views:RegistrerFilmView />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Rectangle Grid.Row="0" Grid.ColumnSpan="2" Fill="#F5F5F5" />

        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>



        </Grid>

        <!--Navigation Bar-->
        <Border Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" BorderBrush="Gray" BorderThickness="0,0,0,0" Background="#F5F5F5">
            <StackPanel Margin="10,0,10,10">
                <TextBlock Text="The Movies" 
                      Background="Transparent"
                   FontSize="24" 
                   FontWeight="Bold" Margin="0,0,0,0"/>
                <TextBlock Text="Navigation" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                <Button Content="Filmoversigt" 
                        Command="{Binding NavigateToFilmoversigCommand}"
                        Padding="10,8"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="White"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        Cursor="Hand"
                        Margin="0,0,0,5"/>

                <Button Content="Registrer film" 
                        Command="{Binding NavigateToRegistrerFilmCommand}"
                        Padding="10,8"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="White"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <ContentControl Grid.Row="2" Grid.Column="1" 
                        Content="{Binding CurrentViewModel}"
                        Margin="10"/>
    </Grid>
</Window>
